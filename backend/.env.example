# Glunova hybrid backend — copy to backend/.env and edit.
#
#   cp backend/.env.example backend/.env        (macOS / Linux)
#   copy backend\.env.example backend\.env      (Windows CMD)
#
# Django and FastAPI both read backend/.env (see backend/django_app/core/settings.py
# and backend/fastapi_ai/core/config.py).

# --- Required ---
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Django ---
DJANGO_SECRET_KEY=change-me-in-production
# Set to false in production
DJANGO_DEBUG=true
# Comma-separated browser origins for CORS
# Local: http://localhost:3000
# Production: https://your-app.vercel.app
FRONTEND_ORIGINS=http://localhost:3000

# JWT signing — set the same value in both Django and FastAPI
JWT_SHARED_SECRET=change-me-in-production

# Django calls FastAPI:
#   Local (host): AI_SERVICE_URL=http://127.0.0.1:8001
#   Production (Docker compose): AI_SERVICE_URL=http://fastapi_ai:8001  ← set in docker-compose.prod.yml
AI_SERVICE_URL=http://127.0.0.1:8001
FASTAPI_BASE_URL=http://127.0.0.1:8001

# --- Groq (FastAPI: LLM / vision routes) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Optional: document uploads (Supabase) ---
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=
# SUPABASE_STORAGE_BUCKET=medical-documents

# --- Optional: Qdrant (psychology RAG / memory) ---
# QDRANT_URL=
# QDRANT_API_KEY=

# --- Optional: psychology voice (ElevenLabs TTS) ---
# ELEVENLABS_API_KEY=

# --- Optional: Hugging Face (HF_TOKEN or HUGGINGFACE_HUB_TOKEN for pipelines / inference) ---
# HF_TOKEN=

# --- Optional: Azure Document Intelligence (OCR) ---
# AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
# AZURE_DOCUMENT_INTELLIGENCE_KEY=

# --- Optional: Retinopathy CUDA (requires PyTorch CUDA build + drivers) ---
# RETINOPATHY_TORCH_DEVICE=auto   # auto | cuda | cpu

# --- Nutrition pipeline YOLO backend ---
# roboflow (default, no local model) | groq_only | ultralytics (local, needs model weights)
NUTRITION_YOLO_BACKEND=roboflow
# ROBOFLOW_API_KEY=
# ROBOFLOW_YOLO_WORLD_VERSION=v2-s

# --- Production flags (set these when deploying) ---
# FASTAPI_SKIP_STARTUP_WARMUP=false
